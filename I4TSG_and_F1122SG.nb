 RowBox[{
  RowBox[{"EvenDoubleSum", "[", "list_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b"}], "}"}], ",", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n1", "->", "1"}], ",", 
              RowBox[{"n2", "->", "1"}], ",", 
              RowBox[{"r", "->", "1"}]}], "}"}]}], ",", 
           RowBox[{"Exponent", "[", 
            RowBox[{"#", ",", "n1"}], "]"}], ",", 
           RowBox[{"Exponent", "[", 
            RowBox[{"#", ",", "n2"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Exponent", "[", 
               RowBox[{"#", ",", "r"}], "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"n1", "->", "0"}], ",", 
                RowBox[{"n2", "->", "0"}]}], "}"}]}], ")"}]}]}], "}"}], "&"}],
         ",", "list"}], "]"}]}], ";", 
     RowBox[{"b", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
