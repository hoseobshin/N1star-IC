Cell["\<\
Thus, we define remaining part, which Mathematica can integrate automatically.\
\>", "Text",
 CellChangeTimes->{{3.998962428805162*^9, 3.998962432923552*^9}, {
  3.999315087490367*^9, 3.999315170160987*^9}, {3.999647553571146*^9, 
  3.9996475881810007`*^9}},
 FontColor->RGBColor[
  0.67, 0.54, 0.42],ExpressionUUID->"bc680c0b-6f80-4991-82d1-e8b58de9068f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"totalIntegrandsP", "=", 
   RowBox[{"Delete", "[", 
    RowBox[{"totalIntegrands", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "111", "}"}], ",", 
       RowBox[{"{", "113", "}"}], ",", 
       RowBox[{"{", "115", "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9989624731813917`*^9, 3.998962522101428*^9}, {
  3.998963309715169*^9, 3.998963330758009*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"03d019c4-9e3d-4395-9384-4dc28ef15999"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "we", " ", "can", " ", "calculate", " ", "three", " ", "indefinite", " ", 
   "integrals", " ", 
   RowBox[{"\[Integral]", 
    RowBox[{
     RowBox[{"PolyLog", "[", 
      RowBox[{"3", ",", 
       FractionBox[
        RowBox[{"1", "+", "r"}], 
        RowBox[{"1", "-", "r"}]]}], "]"}], 
     RowBox[{"\[DifferentialD]", "r"}]}]}]}], " ", ",", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"PolyLog", "[", 
     RowBox[{"3", ",", 
      FractionBox[
       RowBox[{"1", "+", "r"}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", "r"}]]}], "]"}], 
    RowBox[{"\[DifferentialD]", "r"}]}]}], " ", ",", " ", 
  RowBox[{"\[Integral]", 
   RowBox[{
    RowBox[{"PolyLog", "[", 
     RowBox[{"3", ",", 
      RowBox[{"1", "-", 
       SuperscriptBox["r", "2"]}]}], "]"}], 
    RowBox[{"\[DifferentialD]", "r"}], " ", "by", " ", 
    RowBox[{"hand", "."}]}]}]}]], "Text",
 CellChangeTimes->{{3.998963484459568*^9, 3.998963534045307*^9}, {
  3.999315023105708*^9, 3.9993150605893993`*^9}, {3.9996476049925117`*^9, 
  3.999647618551958*^9}},
 FontColor->RGBColor[
  0.67, 0.54, 0.42],ExpressionUUID->"bcd90afa-3f8a-4d4a-83ec-e3435011b088"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PL3int1", "=", 
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{"PolyLog", "[", 
       RowBox[{"3", ",", 
        FractionBox[
         RowBox[{"1", "+", "r"}], 
         RowBox[{"1", "-", "r"}]]}], "]"}]}], "+", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "8", "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "r"}], "]"}], "2"]}], "-", 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "r"}], "]"}], "3"], "+", 
        RowBox[{"3", " ", 
         SuperscriptBox[
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "r"}], "]"}], "2"], " ", 
         RowBox[{"Log", "[", "r", "]"}]}], "-", 
        RowBox[{"3", " ", 
         SuperscriptBox[
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "r"}], "]"}], "2"], " ", 
         RowBox[{"Log", "[", 
          FractionBox[
           RowBox[{"2", " ", "r"}], 
           RowBox[{
            RowBox[{"-", "1"}], "+", "r"}]], "]"}]}], "+", 
        RowBox[{"3", " ", 
         RowBox[{"Log", "[", 
          FractionBox["1", 
           RowBox[{"1", "-", "r"}]], "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Log", "[", 
           FractionBox[
